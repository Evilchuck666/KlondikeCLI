{
  "version": "2.0.0",
  "tasks": [
    {
      // Debug build tree for the debugger. It also writes compile_commands.json for clangd.
      "label": "configure (Debug)",
      "type": "process",
      "command": "cmake",
      "args": ["-S", ".", "-B", "cmake-build-debug", "-DCMAKE_BUILD_TYPE=Debug", "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"],
      "problemMatcher": []
    },
    {
      "label": "build (Debug)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "cmake-build-debug"],
      "dependsOn": "configure (Debug)",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      // Release build tree: same commands as the README and the CI build.
      "label": "configure (Release)",
      "type": "process",
      "command": "cmake",
      "args": ["-S", ".", "-B", "build", "-DCMAKE_BUILD_TYPE=Release"],
      "problemMatcher": []
    },
    {
      "label": "build (Release)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "build", "--config", "Release"],
      "dependsOn": "configure (Release)",
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      // Same scripted game as the CI smoke test: seed 42, one card at a time, open two cards, show the menu and quit.
      "label": "smoke test (Release)",
      "type": "shell",
      "command": "output=$(printf '42\\n1\\n1\\n1\\n9\\n0\\n' | ./build/KlondikeCLI) && echo \"$output\" && grep -q 'ABANDONED GAME' <<< \"$output\" && echo 'Smoke test OK'",
      "options": {
        "shell": {
          "executable": "bash",
          "args": ["-c"]
        }
      },
      "dependsOn": "build (Release)",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
