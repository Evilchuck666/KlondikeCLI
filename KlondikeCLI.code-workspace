{
  // Workspace-level configuration: folders, settings and extension recommendations.
  // Building and debugging the folder live in .vscode/tasks.json and .vscode/launch.json, never here.
  "folders": [
    {
      "name": "KlondikeCLI",
      "path": "."
    }
  ],
  "settings": {
    // Same style as the files in the repository: LF, final newline, no trailing whitespace.
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    // The C++ sources are indented with 4 spaces, no tabs.
    "[cpp]": {
      "editor.insertSpaces": true,
      "editor.tabSize": 4
    },
    // clangd reads compile_commands.json from the Debug build tree written by the "configure (Debug)" task.
    "clangd.arguments": ["--compile-commands-dir=${workspaceFolder}/cmake-build-debug"],
    // If the Microsoft C/C++ extension is also installed, clangd stays the only IntelliSense engine.
    "C_Cpp.intelliSenseEngine": "disabled"
  },
  "extensions": {
    "recommendations": [
      "llvm-vs-code-extensions.vscode-clangd",
      "vadimcn.vscode-lldb",
      "github.vscode-github-actions"
    ]
  }
}
