# CMake build trees: build/ is the Release build (README, CI and VS Code tasks),
# cmake-build-debug/ is the Debug build used by the VS Code debugger and clangd.
build/
cmake-build-*/

# Install staging used by the release workflow (cmake --install --prefix dist/...)
dist/

# CLion
.idea/

# makepkg output when testing packaging/arch/PKGBUILD in place
packaging/arch/src/
packaging/arch/pkg/
packaging/arch/*.tar.gz
packaging/arch/*.pkg.tar.*
